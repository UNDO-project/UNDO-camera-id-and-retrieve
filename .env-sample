# Sample environment configuration for cctv-scrapers
# Copy this file to `.env` and adjust the values as needed.

# Path to the YOLOv8 camera detector weights used by the identification system.
# If unset, the application will fall back to `model_weights/yolov8_camera.pt`.
CAMERA_DETECTOR_WEIGHTS=/absolute/or/project/relative/path/to/model_weights/yolov8_camera.pt
